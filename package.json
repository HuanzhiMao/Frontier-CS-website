{
  "name": "cp-benchmark-for-llm-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/parse-results.js && node scripts/generate-cp-leaderboard.js && node scripts/copy-problem-files.js",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/create-404.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-client": "openapi-ts --input https://webhook.cp-bench.orzzh.com/openapi.json --output ./src/api --client @hey-api/client-axios",
    "parse-data": "node scripts/parse-results.js && node scripts/generate-cp-leaderboard.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hey-api/client-axios": "^0.6.0",
    "@mui/lab": "6.0.0-beta.26",
    "@mui/material": "^6.4.2",
    "@mui/x-charts": "^7.27.0",
    "@mui/x-data-grid": "^7.25.0",
    "@types/d3": "^7.4.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ahooks": "^3.8.4",
    "d3": "^7.9.0",
    "d3-scale-chromatic": "^3.1.0",
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.6.1",
    "react-syntax-highlighter": "^16.1.0",
    "vue-echarts": "^7.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@hey-api/openapi-ts": "^0.64.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "rollup": "^4.53.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
